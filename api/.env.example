# .env.example — Environment Configuration Template
# 
# IMPORTANT: DO NOT copy this file directly to .env in production.
# Each value MUST be explicitly set for your environment.
# For production: use your platform's secret manager (GitHub Secrets, Render dashboard, etc.)
# NEVER commit real secrets or credentials to git.

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================
# If any REQUIRED variable is missing, the service will crash at startup
# with a clear error message. This is intentional — misconfiguration is a
# security vulnerability (see module-03-reflection.md for details).

# Runtime environment
# REQUIRED. Choose one: development, staging, production
# WARNING: This affects error verbosity and log levels.
# In development: error responses include full stack traces (for debugging)
# In production: error responses are generic (to prevent information leakage)
# Misconfiguring this in production can expose internal details like SQL queries,
# database schema, and application file paths to end users.
APP_ENV=development

# Service port
# REQUIRED. Must be an integer between 1 and 65535.
# In Docker: use -e PORT=9000 to override
# Example: docker run -e PORT=9000 -e APP_ENV=production linkops-api:latest
PORT=8000

# Database connection string
# REQUIRED. Format: postgresql[+psycopg]://user:password@host:port/database
# NOTE: Must include authentication credentials and hostname.
# Examples:
#   Local development:  postgresql+psycopg://postgres:postgres@localhost:5432/linkops_dev
#   Staging:            postgresql+psycopg://user:secure-pass@staging-db.example.com:5432/linkops_stage
#   Production:         postgresql+psycopg://user:secure-pass@prod-db.example.com:5432/linkops
# SECURITY: NEVER commit real production credentials. Store in secret manager.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/linkops_dev

# JWT signing secret
# REQUIRED. Minimum 32 characters. Must be cryptographically random.
# Used to sign authentication tokens. If changed, existing tokens become invalid.
# Generate new secret:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECURITY: This example value is for development only.
#           NEVER use in production. NEVER commit real secrets to git.
#           Store real secrets in: GitHub Secrets → CI/CD env vars
JWT_SECRET=dev-secret-key-change-me-in-production-xxxxxxxx

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Logging level
# OPTIONAL. Default: info
# Choices: debug, info, warning, error, critical
# Use debug in development for more detailed logs; warning in production for less noise
LOG_LEVEL=info

# ============================================================================
# UNUSED (reserved for future modules)
# ============================================================================
# MONGODB_URI=
# REDIS_URL=
# API_KEY_A=
# API_KEY_B=
